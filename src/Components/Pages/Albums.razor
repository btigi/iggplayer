@page "/albums"
@implements IDisposable
@using IggPlayer.Data
@using IggPlayer.Services
@inject MusicService MusicService
@inject PlaylistService Playlist
@inject PlayLogService PlayLogService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="app-container">
    <header class="app-header">
        <h1 class="page-heading">Albums</h1>
        <div class="header-actions">
            @if (!string.IsNullOrEmpty(ArtistFilter))
            {
                <span class="track-count">@ArtistFilter</span>
            }
            @if (_albums is not null)
            {
                <span class="track-count">@_albums.Count albums</span>
            }
        </div>
    </header>

    <div class="search-section">
        <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
            </svg>
            <input type="text"
                   class="search-input"
                   placeholder="@(string.IsNullOrEmpty(ArtistFilter) ? "Search albums..." : $"Search albums by {ArtistFilter}...")"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button class="search-clear" @onclick="ClearSearch">&times;</button>
            }
        </div>
    </div>

    @if (_albums is null)
    {
        <div class="loading">Loading...</div>
    }
    else if (_albums.Count == 0)
    {
        <div class="empty-state">
            @if (!string.IsNullOrEmpty(ArtistFilter) && string.IsNullOrEmpty(_searchQuery))
            {
                <p>No albums found for "<strong>@ArtistFilter</strong>"</p>
            }
            else if (string.IsNullOrEmpty(_searchQuery))
            {
                <p>No albums found.</p>
            }
            else
            {
                <p>No albums match "<strong>@_searchQuery</strong>"</p>
            }
        </div>
    }
    else
    {
        <div class="library-list">
            @foreach (var album in _albums)
            {
                <div class="library-list-item">
                    <div class="library-list-text">
                        <span class="library-list-title"
                              onmouseenter="this.scrollWidth > this.clientWidth ? this.title = this.textContent.trim() : this.removeAttribute('title')">@album.Name</span>
                        @if (string.IsNullOrEmpty(ArtistFilter) && !string.IsNullOrEmpty(album.Artist))
                        {
                            <span class="library-list-subtitle"
                                  onmouseenter="this.scrollWidth > this.clientWidth ? this.title = this.textContent.trim() : this.removeAttribute('title')">@album.Artist</span>
                        }
                    </div>
                    <div class="library-list-actions">
                        <button type="button" class="library-action-btn" @onclick="() => SearchForAlbum(album)" title="Show tracks on this album">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                            </svg>
                        </button>
                        <button type="button" class="library-action-btn" @onclick="() => AddAlbumToPlaylist(album)" title="Add album to playlist">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/><path d="M19 3v6M16 6h6"/>
                            </svg>
                        </button>
                        <button type="button" class="library-action-btn" @onclick="() => PlayAlbumNow(album)" title="Play album now">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5,3 19,12 5,21"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private string _searchQuery = "";
    private List<AlbumInfo>? _albums;
    private CancellationTokenSource? _debounceCts;
    private IJSObjectReference? _persistenceModule;
    private string? _loadedArtistFilter;

    [SupplyParameterFromQuery(Name = "artist")]
    public string? ArtistFilter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_albums is null || !string.Equals(_loadedArtistFilter, ArtistFilter, StringComparison.Ordinal))
        {
            _searchQuery = "";
            await LoadAlbumsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _persistenceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/persistence.js");
    }

    private async Task LoadAlbumsAsync()
    {
        _loadedArtistFilter = ArtistFilter;
        _albums = string.IsNullOrWhiteSpace(ArtistFilter)
            ? await MusicService.GetAlbumsAsync(_searchQuery)
            : await MusicService.GetAlbumsByArtistAsync(ArtistFilter, _searchQuery);
    }

    private async Task OnSearchChanged()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(300, token);
            await LoadAlbumsAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchQuery = "";
        await LoadAlbumsAsync();
    }

    private async Task SearchForAlbum(AlbumInfo album)
    {
        _persistenceModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/persistence.js");
        await _persistenceModule.InvokeVoidAsync("setLastSearch", album.Name);
        await _persistenceModule.InvokeVoidAsync("setLastAlbumFolder", album.Folder);
        Nav.NavigateTo("/");
    }

    private async Task AddAlbumToPlaylist(AlbumInfo album)
    {
        var tracks = await MusicService.GetTracksByAlbumAsync(album.Folder);
        foreach (var track in tracks)
            Playlist.Enqueue(track);
    }

    private async Task PlayAlbumNow(AlbumInfo album)
    {
        var tracks = await MusicService.GetTracksByAlbumAsync(album.Folder);
        if (tracks.Count == 0) return;

        Playlist.RestoreFromTracks(tracks, 0);
        await PlayLogService.LogPlayAsync(tracks[0]);
    }

    public void Dispose()
    {
        _debounceCts?.Dispose();
        _ = _persistenceModule?.DisposeAsync();
    }
}
